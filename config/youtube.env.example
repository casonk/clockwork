# YouTube integration for the Clockwork web service.
# Keep real values in ~/.config/clockwork/clockwork-web.env, not in git.

# Recommended: an owner-only multi-account registry. Relative OAuth paths in
# that JSON resolve beside the registry.
CLOCKWORK_YOUTUBE_ACCOUNTS_FILE=/home/you/.config/clockwork/youtube-accounts.json

# Legacy single-account settings (used only when the registry does not exist).
CLOCKWORK_YOUTUBE_OAUTH_FILE=/home/you/.config/clockwork/youtube-oauth.json
CLOCKWORK_YOUTUBE_WATCH_PLAYLIST_ID=
CLOCKWORK_YOUTUBE_LISTEN_PLAYLIST_ID=

# Optional local category names for newly imported videos (default: YouTube).
# CLOCKWORK_YOUTUBE_WATCH_CATEGORY=YouTube
# CLOCKWORK_YOUTUBE_LISTEN_CATEGORY=YouTube
