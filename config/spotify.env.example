# Spotify integration for the Clockwork web service (To Listen only).
# Keep real values in ~/.config/clockwork/clockwork-web.env, not in git.

# Owner-only (0600) grant written by scripts/authorize_spotify.py --write.
CLOCKWORK_SPOTIFY_OAUTH_FILE=/home/you/.config/clockwork/spotify-oauth.json

# Optional: the "＋ Spotify List" button stores the playlist id in the grant file;
# set it here only to point at a different private playlist.
# CLOCKWORK_SPOTIFY_LISTEN_PLAYLIST_ID=

# Optional local category for tracks imported from the playlist (default: Spotify).
# CLOCKWORK_SPOTIFY_LISTEN_CATEGORY=Spotify
