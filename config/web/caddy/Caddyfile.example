{
	email admin@example.com
}

# clockwork-web private HTTPS + mTLS example
#
# Serves the clockwork configuration web UI at config.clockwork.internal over
# HTTPS, requiring a valid client certificate signed by the clockwork mTLS CA.
# Flask runs locally on 127.0.0.1:5000 with no TLS — Caddy is the only public
# endpoint and the mTLS boundary.
#
# Prerequisites:
#   1. Run scripts/setup-mtls.sh to generate certs in ~/.config/clockwork/certs/
#   2. Configure dnsmasq on the WireGuard server (snowbridge) with the snippet
#      written by setup-mtls.sh so that config.clockwork.internal resolves to
#      this machine's WireGuard peer IP.
#   3. Start the Flask service:
#        systemctl --user enable --now clockwork-web.service
#   4. Start Caddy with this config:
#        sudo caddy run --config config/web/caddy/Caddyfile.local

https://config.clockwork.internal {
	tls <path-to-server.crt> <path-to-server.key> {
		client_auth {
			mode require_and_verify
			trust_pool file <path-to-ca.crt>
		}
	}

	encode zstd gzip
	reverse_proxy 127.0.0.1:5000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
	}
}
