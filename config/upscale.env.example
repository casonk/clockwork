# AI super-resolution worker settings (web/upscale.py).
# Copy to config/upscale.env.local (gitignored), edit, then:
#   systemctl --user restart clockwork-upscale
# Values shown are the defaults.

# Throttling: fraction of wall time spent working; the rest is rest.
# Lower is cooler and quieter; 1.0 runs flat out.
CLOCKWORK_UPSCALE_DUTY=0.35

# Pause at these temperatures (Celsius) until both are 6 C cooler.
# The CPU value is the package temperature, median over a few seconds.
CLOCKWORK_UPSCALE_MAX_GPU_C=72
CLOCKWORK_UPSCALE_MAX_CPU_C=78

# CPU threads for ffmpeg decode/encode and PyTorch.
CLOCKWORK_UPSCALE_THREADS=2

# Stop starting new renders when free space on the library disk would drop
# below this many GiB; checked again hourly.
CLOCKWORK_UPSCALE_MIN_FREE_GB=1000

# Live-action detail vs. smoothing: 0 keeps all grain and texture, 1 smooths
# the most (waxy). Blends realesr-general-x4v3 with its weak-denoise twin.
CLOCKWORK_UPSCALE_DENOISE=0.5

# Where the model weights live.
#CLOCKWORK_UPSCALE_MODELS=~/.cache/clockwork/upscale-models
