@startuml classes_clockwork
set namespaceSeparator none
class "CronSpec" as src.clockwork.model.CronSpec {
  command : str
  comments : tuple[str, ...]
  expression : str
  timezone : str | None
  validate() -> None
}
class "JobSpec" as src.clockwork.model.JobSpec {
  after : tuple[str, ...]
  cron : CronSpec | None
  description : str
  environment : dict[str, str]
  environment_files : tuple[str, ...]
  exec_start : str
  group : str | None
  launchd_label : str | None
  launchd_overrides : TargetOverrides | None
  launchd_run_at_load : bool | None
  name : str
  poll_interval : str | None
  restart : str | None
  restart_sec : str | None
  scope : str
  service_install_wanted_by : tuple[str, ...]
  service_name : str | None
  service_type : str
  standard_error : str | None
  standard_output : str | None
  start_limit_interval_sec : str | None
  timer : TimerSpec | None
  timer_description : str | None
  timer_name : str | None
  user : str | None
  wants : tuple[str, ...]
  windows_overrides : TargetOverrides | None
  working_directory : str | None
  for_launchd() -> JobSpec
  for_target(target: str) -> JobSpec
  for_windows() -> JobSpec
  service_unit_name() -> str
  timer_unit_name() -> str
  validate() -> None
}
class "Manifest" as src.clockwork.model.Manifest {
  jobs : tuple[JobSpec, ...]
  path : str
  validate() -> None
}
class "TargetOverrides" as src.clockwork.model.TargetOverrides {
  accuracy_sec : str | None
  after : tuple[str, ...] | None
  environment : dict[str, str] | None
  exec_start : str | None
  randomized_delay_sec : str | None
  wants : tuple[str, ...] | None
  working_directory : str | None
  validate() -> None
}
class "TimerSpec" as src.clockwork.model.TimerSpec {
  accuracy_sec : str | None
  install_wanted_by : str
  kind : str
  on_boot_sec : str | None
  on_calendar : str | None
  on_unit_active_sec : str | None
  persistent : bool
  randomized_delay_sec : str | None
  unit : str | None
  validate() -> None
}
@enduml
